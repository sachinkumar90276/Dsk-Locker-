# Render Backend + Neon PostgreSQL Configuration (NEVER commit real secrets or expose in Android app)
PORT=8080

# Required: Neon PostgreSQL connection string (keep strictly server-side on Render)
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-neon-host.us-east-2.aws.neon.tech/neondb?sslmode=require
PG_SSL=auto

# Required: Server master secret used for AES-256-GCM wrapping of portable vault recovery keys (32+ chars / 64 hex)
VAULT_MASTER_SECRET=

# Required for deployed web frontends: Comma-separated CORS origin allowlist (no wildcard * on authenticated APIs).
# Capacitor origins (capacitor://localhost, ionic://localhost, https://localhost, http://localhost) are supported automatically.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Neon Free Tier & Render Upload Guardrails
NEON_FREE_TIER_LIMIT_MB=512
DEFAULT_USER_QUOTA_MB=450
MAX_BACKUP_FILE_MB=20

# Firebase Admin SDK credentials (use FIREBASE_SERVICE_ACCOUNT_JSON on Render, or file path locally)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Leave blank for strict multi-user Firebase UID isolation, or pin to single authorized owner
AUTHORIZED_OWNER_PHONE=
OWNER_FIREBASE_UID=
