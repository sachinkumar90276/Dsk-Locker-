# Server Configuration (NEVER commit real secrets or expose in Android app)
PORT=8080
DATABASE_URL=postgres://dsk_admin:STRONG_PASSWORD@localhost:5432/dsk_locker
PG_SSL=false

# Firebase Admin SDK service account JSON path (server-side only)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Pin single authorized owner phone (+91...) and/or Firebase UID
AUTHORIZED_OWNER_PHONE=
OWNER_FIREBASE_UID=
