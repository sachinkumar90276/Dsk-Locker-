rules_version = '2';

// DSK LOCKER Private Owner-Only Firebase Storage Rules
// Enforces strictly isolated private paths per Firebase UID.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/documents/{allPaths=**} {
      allow read, write, delete: if isOwner(uid);
    }

    match /users/{uid}/photos/{allPaths=**} {
      allow read, write, delete: if isOwner(uid);
    }

    match /users/{uid}/videos/{allPaths=**} {
      allow read, write, delete: if isOwner(uid);
    }

    match /users/{uid}/audio/{allPaths=**} {
      allow read, write, delete: if isOwner(uid);
    }

    match /users/{uid}/vault/{allPaths=**} {
      allow read, write, delete: if isOwner(uid);
    }

    // Deny all other storage paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
