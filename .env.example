# DSK LOCKER Render Backend Configuration (Configure in AI Studio Secrets Panel)
# Base URL of your deployed Render DSK LOCKER Backend API (Neon PostgreSQL + Firebase Admin verification).
# NOTE: Do NOT set DATABASE_URL, VAULT_MASTER_SECRET, or any Supabase URL here.
BACKEND_API_URL=https://your-dsk-locker-backend.onrender.com

# Optional: Restrict device registration & login to one authorized owner mobile number in +91 format
AUTHORIZED_OWNER_PHONE=OPTIONAL_OWNER_PHONE
